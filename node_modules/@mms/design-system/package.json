  "publishConfig": {
    "registry": "https://artifactory.mars.pcf-maximus.com/artifactory/api/npm/mms-ds-platform/"
  },
  "scripts": {
    "build": "npm run analyze && npm run generate-react && npm run build-package",
    "build-package": "node scripts/build-package.mjs",
    "build-tokens": "echo 'DEPRECATED: CSS is now source of truth. See tokens-archive/ for reference.'",
    "analyze": "cem analyze --litelement",
    "generate-react": "node scripts/generate-react.mjs",
    "generate-exports": "node scripts/generate-exports.mjs",
    "typecheck:react": "tsc --noEmit -p tsconfig.react.json",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "storybook build",
    "predeploy": "DEPLOY_TARGET=gh-pages npm run build-storybook && node patch-storybook.cjs",
    "deploy": "gh-pages -d storybook-static --repo https://github.com/638088/mms-ds-storybook.git",
    "test": "npm run test:unit && npm run test:a11y",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "validate:tracker": "node scripts/validate-tracker.mjs",
    "audit:hardcoded": "node scripts/audit-hardcoded-values.mjs",
    "audit:contrast": "node scripts/contrast-check.mjs",
    "audit:a11y-coverage": "node scripts/audit-a11y-coverage.mjs",
    "build-wcag-tables": "node scripts/build-wcag-tables.mjs",
    "verify-bundle": "node scripts/verify-bundle.mjs",
    "verify-gates": "node scripts/verify-gates.mjs",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry-run": "standard-version --dry-run",
    "prepare": "husky || true"
  },
